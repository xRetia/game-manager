<Window x:Class="GameManager.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gm="clr-namespace:GameManager"
        Title="" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="True" SnapsToDevicePixels="True" UseLayoutRounding="True"
        KeyDown="OnKeyDown">

    <Window.Resources>

        <!-- neutral button (cancel) -->
        <Style x:Key="CfmButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D4D8E0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="11" Background="#2D3340"
                                BorderThickness="1.5" BorderBrush="#2D3340"
                                Width="120" Height="42">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#404758"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#404758"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A5265"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A5265"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- destructive confirm button: warm orange fill -->
        <Style x:Key="CfmButtonDanger" TargetType="Button" BasedOn="{StaticResource CfmButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="11" Background="#C97A35"
                                BorderThickness="1.5" BorderBrush="#C97A35"
                                Width="120" Height="42">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8833A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E8833A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B56A2A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#B56A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="#F51A1E26" CornerRadius="16"
            BorderBrush="#39404F" BorderThickness="1"
            Margin="18" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Color="#000000" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel Margin="26,22,26,16">

            <!-- title row: vector warning triangle + title -->
            <StackPanel Orientation="Horizontal">
                <Canvas Width="26" Height="26" VerticalAlignment="Center">
                    <Path Data="M13,3.4 L23,21.4 L3,21.4 Z"
                          Stroke="#EDB084" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                    <Path Data="M13,10.2 L13,15.2" Stroke="#EDB084" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse Canvas.Left="12" Canvas.Top="17.4" Width="2.2" Height="2.2" Fill="#EDB084"/>
                </Canvas>
                <TextBlock x:Name="TitleText" Text="" FontSize="17" FontWeight="Bold"
                           Foreground="#EEF0F5" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>

            <!-- body -->
            <TextBlock x:Name="BodyText" Text="" Foreground="#C5CBD8" FontSize="13"
                       LineHeight="21" Margin="0,14,0,0" TextWrapping="Wrap"/>

            <!-- action row: cancel (safe default) + destructive confirm.
                 The focus indicator is a shared ring (FocusRing) that GLIDES
                 between the two buttons like the power panel's circle ring,
                 instead of blinking on the new button. -->
            <Grid HorizontalAlignment="Right" Margin="0,22,0,0">

                <!-- sliding focus ring: driven by a TranslateTransform
                     (X animatable, Margin is not); never blocks clicks -->
                <Border x:Name="FocusRing" Width="126" Height="48" CornerRadius="13"
                        BorderThickness="1.5" BorderBrush="#A9BCFF" Opacity="0"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="-3,-3,0,0" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="RingSlide"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="12" Color="#6082FF" Opacity="0.6"/>
                    </Border.Effect>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CancelButton" Style="{StaticResource CfmButton}"
                            Content="{x:Static gm:Strings.PowerCancel}"
                            GotKeyboardFocus="OnButtonFocusChanged" Click="OnCancel"/>
                    <Button x:Name="ConfirmButton" Style="{StaticResource CfmButtonDanger}"
                            GotKeyboardFocus="OnButtonFocusChanged" Click="OnConfirm" Margin="12,0,0,0">
                        <TextBlock x:Name="ConfirmButtonText" Text=""/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- key/button hints, following the live input device -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,2,0">
                <Border x:Name="EnterBadge" Width="34" Height="22" CornerRadius="11" BorderThickness="1.2"
                        BorderBrush="#7D93FF" Background="#242C48" VerticalAlignment="Center">
                    <TextBlock Text="Enter" FontSize="9" Foreground="#BAC6FF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="PadABadge" Width="22" Height="22" CornerRadius="11" BorderThickness="1.2"
                        BorderBrush="#7D93FF" Background="#242C48" Margin="6,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="A" FontSize="10.5" Foreground="#BAC6FF" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{x:Static gm:Strings.PowerConfirm}" Foreground="#6E7686" FontSize="11.5"
                           VerticalAlignment="Center" Margin="7,0,12,0"/>
                <Border x:Name="EscBadge" Width="22" Height="22" CornerRadius="11" BorderThickness="1.2"
                        BorderBrush="#5A6272" Background="#222835" VerticalAlignment="Center">
                    <TextBlock Text="Esc" FontSize="8.5" Foreground="#98A0B0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="PadBBadge" Width="22" Height="22" CornerRadius="11" BorderThickness="1.2"
                        BorderBrush="#5A6272" Background="#222835" Margin="6,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="B" FontSize="10" Foreground="#98A0B0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{x:Static gm:Strings.PowerCancel}" Foreground="#6E7686" FontSize="11.5"
                           VerticalAlignment="Center" Margin="7,0,0,0"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
