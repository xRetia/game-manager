<Window x:Class="GameManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gm="clr-namespace:GameManager"
        Title="{x:Static gm:Strings.AppTitle}"
        Width="1100" Height="700"
        WindowState="Maximized"
        SourceInitialized="OnSourceInit"
        KeyDown="OnWindowKeyDown">

    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#161923"/>
            <GradientStop Color="#0D0F15" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <DockPanel>

        <!-- header -->
        <Border DockPanel.Dock="Top" Height="70" Background="#181C22"
                BorderBrush="#2C3240" BorderThickness="0,0,0,1">
            <Grid x:Name="HeaderRoot">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="{x:Static gm:Strings.AppTitle}" FontSize="19" FontWeight="Bold"
                                   Foreground="#EEF0F5" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="16" Color="#6082FF" Opacity="0.35"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="CountText" Text="" Foreground="#8C94A5"
                                   FontSize="13" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,22,0">
                        <Button x:Name="RefreshButton" Style="{StaticResource ChromeButton}" Click="OnRefresh" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="#9AA3B4" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static gm:Strings.BtnRefresh}" Margin="7,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FullScreenButton" Style="{StaticResource ChromeButton}" Click="OnFullScreen" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="#9AA3B4" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static gm:Strings.BtnFullScreen}" Margin="7,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AdvancedButton" Style="{StaticResource ChromeButton}" Click="OnAdvanced" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="#9AA3B4" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static gm:Strings.BtnAdvanced}" Margin="7,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AboutButton" Style="{StaticResource ChromeButton}" Click="OnAbout">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="#9AA3B4" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static gm:Strings.BtnAbout}" Margin="7,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- console-style chrome focus: glides across the header buttons
                     while the gamepad/keyboard navigates them -->
                <Border x:Name="ChromeFocus" IsHitTestVisible="False" Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Width="80" Height="30" CornerRadius="12" Opacity="0"
                        BorderThickness="2" BorderBrush="#A9BCFF">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="18" Color="#6082FF" Opacity="0.8"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ChromeTransform"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>

        <!-- game area: acrylic backdrop + touch-scrollable tile grid -->
        <Grid>
            <!-- backdrop: BitmapCache caches the 120px blur result so scrolling/tile
                 animations never re-run the full-screen gaussian every frame -->
            <Image x:Name="AcrylicImage" Source="{x:Null}" Stretch="UniformToFill">
                <Image.Effect>
                    <BlurEffect KernelType="Gaussian" Radius="120"/>
                </Image.Effect>
                <Image.CacheMode>
                    <BitmapCache/>
                </Image.CacheMode>
            </Image>
            <Border Background="#D212141B" IsHitTestVisible="False"/>

            <ScrollViewer x:Name="Scroller"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          ManipulationBoundaryFeedback="OnManipulationBoundary">
                <Grid x:Name="TilesHost">
                    <ItemsControl x:Name="TilesControl" MouseDoubleClick="OnTileDoubleClick">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TileButton}" Click="OnTileClick"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- console-style selection cursor: glides from tile to tile.
                         BitmapCache freezes the frame + double-stroke glow as a bitmap,
                         so the slide animation just moves cached pixels instead of
                         re-rasterizing the DropShadowEffect on every frame. -->
                    <Border x:Name="CursorFrame" IsHitTestVisible="False" Visibility="Collapsed"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Width="100" Height="100" CornerRadius="21" Opacity="0"
                            BorderThickness="3" BorderBrush="#A9BCFF">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="44" Color="#6082FF" Opacity="0.95"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CursorTransform"/>
                        </Border.RenderTransform>
                        <Border.CacheMode>
                            <BitmapCache/>
                        </Border.CacheMode>
                        <!-- inner highlight ring: brighter core edge on top of the glow -->
                        <Border BorderThickness="1.2" BorderBrush="#59FFFFFF"
                                CornerRadius="19" Margin="1.4" IsHitTestVisible="False"/>
                    </Border>
                </Grid>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHint" Visibility="Collapsed"
                       Text="" Foreground="#828A9B" FontSize="15"
                       Margin="64,56,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <!-- console-style input hint, bottom-right; swaps between gamepad
                 and keyboard glyphs based on the last used input device -->
            <Border x:Name="InputHint" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,22,18" IsHitTestVisible="False" Opacity="0"
                    Background="#E6151922" CornerRadius="17" Padding="15,8"
                    BorderBrush="#2C3344" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="16" Color="#000000" Opacity="0.35"/>
                </Border.Effect>
                <Grid>
                    <!-- gamepad variant: dpad + A (shown once pad input is detected) -->
                    <StackPanel x:Name="PadHints" Orientation="Horizontal" Visibility="Collapsed">
                        <Grid Width="17" Height="17" VerticalAlignment="Center">
                            <Rectangle Width="5.5" Height="16" RadiusX="1.6" RadiusY="1.6"
                                       Fill="#7A86A0" HorizontalAlignment="Center"/>
                            <Rectangle Width="16" Height="5.5" RadiusX="1.6" RadiusY="1.6"
                                       Fill="#7A86A0" VerticalAlignment="Center"/>
                            <Rectangle Width="3.5" Height="3.5" Fill="#151922"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{x:Static gm:Strings.HintNavigate}" Foreground="#9AA3B4" FontSize="12.5"
                                   VerticalAlignment="Center" Margin="7,0,0,0"/>
                        <Rectangle Width="1" Height="12" Fill="#2C3344" Margin="13,1"
                                   VerticalAlignment="Center"/>
                        <Grid Width="17" Height="17" VerticalAlignment="Center">
                            <Ellipse Fill="#242C48" Stroke="#7D93FF" StrokeThickness="1.6"/>
                            <TextBlock Text="A" Foreground="#BAC6FF" FontSize="10.5" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-0.5,0,0"/>
                        </Grid>
                        <TextBlock Text="{x:Static gm:Strings.HintOpen}" Foreground="#9AA3B4" FontSize="12.5"
                                   VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>

                    <!-- keyboard variant: arrow-key cluster + Enter (default until pad input) -->
                    <StackPanel x:Name="KeyHints" Orientation="Horizontal">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="7"
                                       Foreground="#7A86A0" Grid.Row="0" Grid.Column="1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="7"
                                       Foreground="#7A86A0" Grid.Row="1" Grid.Column="0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="7"
                                       Foreground="#7A86A0" Grid.Row="1" Grid.Column="1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="7"
                                       Foreground="#7A86A0" Grid.Row="1" Grid.Column="2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{x:Static gm:Strings.HintNavigate}" Foreground="#9AA3B4" FontSize="12.5"
                                   VerticalAlignment="Center" Margin="7,0,0,0"/>

                        <Rectangle Width="1" Height="12" Fill="#2C3344" Margin="13,1"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="&#xE751;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#BAC6FF" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static gm:Strings.HintOpen}" Foreground="#9AA3B4" FontSize="12.5"
                                   VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- launch overlay: spinner + game name while a game is starting up;
                 absorbs clicks so impatient users cannot stack launches -->
            <Border x:Name="LaunchOverlay" Visibility="Collapsed" Opacity="0"
                    Background="#C40E1116">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="58" Height="58" HorizontalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="LaunchSpinner"/>
                        </Grid.RenderTransform>
                        <Ellipse Width="58" Height="58" Stroke="#26FFFFFF" StrokeThickness="4.5"/>
                        <Ellipse Width="58" Height="58" Stroke="#8DA4FF" StrokeThickness="4.5"
                                 StrokeDashArray="27.5 9.2" StrokeDashOffset="4"/>
                    </Grid>
                    <TextBlock x:Name="LaunchText" Text="" Foreground="#C9D2E8" FontSize="15"
                               HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
