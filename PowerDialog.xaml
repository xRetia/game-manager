<Window x:Class="GameManager.PowerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gm="clr-namespace:GameManager"
        Title="" Width="584" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="True" SnapsToDevicePixels="True" UseLayoutRounding="True"
        KeyDown="OnKeyDown">

    <Window.Resources>

        <!-- Android-power-menu style action button: a soft-tinted circle with a
             Segoe MDL2 glyph, the label below - no card chrome. One shared
             template; the circle tint comes from Button.Background, so each
             action keeps its own gentle hue while staying low-contrast
             against the dark panel. The focus ring sits around the circle. -->
        <Style x:Key="PwrButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E9EDF5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Background" Value="#2A303C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Width="96">
                            <Border x:Name="ring" Width="60" Height="60" CornerRadius="30"
                                    BorderThickness="1.5" BorderBrush="Transparent"
                                    HorizontalAlignment="Center">
                                <Border x:Name="circle" Width="52" Height="52" CornerRadius="26"
                                        Background="{TemplateBinding Background}">
                                    <Grid>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border x:Name="hover" CornerRadius="26"
                                                Background="#12FFFFFF" Opacity="0"/>
                                    </Grid>
                                </Border>
                            </Border>
                            <TextBlock Text="{TemplateBinding Tag}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1"/>
                                <Setter TargetName="ring" Property="BorderBrush" Value="#4A5265"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- top-right close button, same glyph + chrome as the About window -->
        <Style x:Key="PwrCloseButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="Transparent"
                                Width="30" Height="30">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="#9AA3B4" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33384455"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="#F51A1E26" CornerRadius="16"
            BorderBrush="#39404F" BorderThickness="1"
            Margin="18" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Color="#000000" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel Margin="26,24,20,18">

            <!-- title row + top-right close -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Canvas Width="24" Height="24" VerticalAlignment="Center">
                        <Path Data="M7.2,5.5 C4.3,7.6 3.1,11.5 4.5,15.1 C6.2,19.4 11.4,21.3 15.6,19.4 C19.4,17.7 21.2,13.2 19.6,9.4 C18.7,7.3 17.1,5.9 15.2,5.2"
                              Stroke="#EDB084" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M11.2,2.8 L11.2,9.2" Stroke="#EDB084" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                    <TextBlock x:Name="TitleText" Text="{x:Static gm:Strings.PowerTitle}" FontSize="17"
                               FontWeight="Bold" Foreground="#EEF0F5" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource PwrCloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="OnClose"/>
            </Grid>

            <TextBlock Text="{x:Static gm:Strings.PowerNote}" Foreground="#98A0B0" FontSize="12.5"
                       Margin="0,14,0,0"/>

            <!-- action row: disconnect / sign out / shut down / restart.
                 Android power-menu anatomy: tinted circle + Segoe MDL2 glyph on
                 top, label below, all buttons the same size. Left/right steps
                 the focus (keyboard arrows, pad dpad/stick), Enter or pad A
                 presses, Esc or pad B cancels. The focus ring slides between
                 the buttons (FocusRing, animated from code) instead of just
                 blinking on the new one. -->
            <Grid HorizontalAlignment="Center" Margin="0,24,0,6">

            <!-- sliding focus ring: one shared element that glides between
                 the four circles; IsHitTestVisible=False so it never blocks
                 clicks. The horizontal position is driven by a
                 TranslateTransform (X is directly animatable, Margin is not). -->
            <Border x:Name="FocusRing" Width="60" Height="60" CornerRadius="30"
                    BorderThickness="1.5" BorderBrush="#A9BCFF" Opacity="0"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,0,0,0"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="RingSlide"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="14" Color="#6082FF" Opacity="0.75"/>
                </Border.Effect>
            </Border>

                <StackPanel Orientation="Horizontal">

                    <Button x:Name="DisconnectButton" Style="{StaticResource PwrButton}"
                            Background="#2E3D55" Tag="{x:Static gm:Strings.PowerExitStream}"
                            GotKeyboardFocus="OnButtonFocusChanged" Click="OnDisconnect">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="24"/>
                    </Button>

                    <Button x:Name="LogOffButton" Style="{StaticResource PwrButton}"
                            Background="#2C3F33" Tag="{x:Static gm:Strings.PowerLogOff}"
                            GotKeyboardFocus="OnButtonFocusChanged" Click="OnLogOff" Margin="24,0,0,0">
                        <TextBlock Text="&#xF3B1;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                    </Button>

                    <Button x:Name="ShutdownButton" Style="{StaticResource PwrButton}"
                            Background="#3D332A" Tag="{x:Static gm:Strings.PowerShutdown}"
                            GotKeyboardFocus="OnButtonFocusChanged" Click="OnShutdown" Margin="24,0,0,0">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                    </Button>

                    <Button x:Name="RestartButton" Style="{StaticResource PwrButton}"
                            Background="#372F47" Tag="{x:Static gm:Strings.PowerRestart}"
                            GotKeyboardFocus="OnButtonFocusChanged" Click="OnRestart" Margin="24,0,0,0">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                    </Button>

                </StackPanel>
            </Grid>

            <!-- action affordance: confirm (Enter/A) and cancel (Esc/B) badges.
                 Both follow the last used input device (keyboard/mouse ->
                 Enter + Esc, gamepad -> A + B) - mirrors the main window's
                 input-hint auto detection. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,2,0">

                <!-- confirm badge -->
                <Border x:Name="EnterBadge" Width="34" Height="24" CornerRadius="12" BorderThickness="1.2"
                        BorderBrush="#7D93FF" Background="#242C48" VerticalAlignment="Center">
                    <TextBlock Text="Enter" FontSize="9.5" Foreground="#BAC6FF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="PadABadge" Width="24" Height="24" CornerRadius="12" BorderThickness="1.2"
                        BorderBrush="#7D93FF" Background="#242C48" Margin="6,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="A" FontSize="11" Foreground="#BAC6FF" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{x:Static gm:Strings.PowerConfirm}" Foreground="#6E7686" FontSize="11.5"
                           VerticalAlignment="Center" Margin="7,0,14,0"/>

                <!-- cancel badge -->
                <Border x:Name="EscBadge" Width="24" Height="24" CornerRadius="12" BorderThickness="1.2"
                        BorderBrush="#5A6272" Background="#222835" VerticalAlignment="Center">
                    <TextBlock Text="Esc" FontSize="9" Foreground="#98A0B0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="PadBBadge" Width="24" Height="24" CornerRadius="12" BorderThickness="1.2"
                        BorderBrush="#5A6272" Background="#222835" Margin="6,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="B" FontSize="10.5" Foreground="#98A0B0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{x:Static gm:Strings.PowerCancel}" Foreground="#6E7686" FontSize="11.5"
                           VerticalAlignment="Center" Margin="7,0,0,0"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
