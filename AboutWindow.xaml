<Window x:Class="GameManager.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gm="clr-namespace:GameManager"
        Title="{x:Static gm:Strings.AboutTitle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="560"
        ShowInTaskbar="False" ResizeMode="NoResize"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnDragMove">

    <Border x:Name="RootCard" Background="#F51A1E26" CornerRadius="16"
            BorderBrush="#39404F" BorderThickness="1"
            Margin="18" Padding="0" ClipToBounds="True" Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Color="#000000" Opacity="0.55"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.97" ScaleY="0.97"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <!-- entrance animation, matching the power dialogs -->
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootCard"
                                         Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="RootScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="1" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="RootScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <!-- body scrolls when the text overflows (long About text, keyboard
             arrows or gamepad right stick) -->
        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
        <StackPanel Margin="30,26,30,24">

            <!-- title row -->
            <Grid>
                <TextBlock Text="{x:Static gm:Strings.AppTitle}" FontSize="17" FontWeight="Bold"
                           Foreground="#EEF0F5" VerticalAlignment="Center"/>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="30" Height="30" Click="OnClose" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="9" Background="Transparent">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#9AA3B4" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#33384455"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- body -->
            <TextBlock x:Name="BodyText" Text="" Foreground="#C5CBD8" FontSize="13"
                       LineHeight="21" Margin="0,16,0,0"/>

            <!-- diagnostics -->
            <TextBlock x:Name="DiagText" Text="" Foreground="#7E8798" FontSize="12"
                       Margin="0,14,0,0"/>

            <Rectangle Height="1" Fill="#2C3344" Margin="0,20,0,16"/>

            <!-- author / copyright / link -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static gm:Strings.AboutAuthorLabel}" Foreground="#7E8798" FontSize="12.5"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Static gm:Strings.AboutAuthor}" Foreground="#D4D8E0" FontSize="12.5"
                           FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="{x:Static gm:Strings.AboutCopyright}" Foreground="#7E8798" FontSize="12.5"
                       Margin="0,6,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="{x:Static gm:Strings.AboutProjectLabel}" Foreground="#7E8798" FontSize="12.5"
                           VerticalAlignment="Center"/>
                <!-- the hyperlink itself is built in code: an x:Static string cannot be
                     assigned to the Uri-typed NavigateUri property (XamlParseException) -->
                <TextBlock x:Name="LinkHost" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12.5"/>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
